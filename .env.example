# Model: auto (Claude if ANTHROPIC_API_KEY is set, else an OpenAI-compatible server), anthropic, openai-compatible
LEAD_AGENT_PROVIDER=auto
ANTHROPIC_API_KEY=
# For Claude: claude-opus-5-5 (default). For a local model: e.g. qwen2.5:7b
LEAD_AGENT_MODEL=

# OpenAI-compatible server: Ollama by default; https://api.openai.com/v1 + OPENAI_API_KEY also works
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=

# Optional web search source (Firecrawl) and the discussion sites it searches
FIRECRAWL_API_KEY=
WEB_SITES=reddit.com,quora.com,indiehackers.com
